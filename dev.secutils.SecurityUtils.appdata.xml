<component type="desktop-application">
    <id>dev.secutils.SecurityUtils</id>
    <metadata_license>MIT</metadata_license>
    <project_license>MIT</project_license>
    <name>Security Utilities</name>
    <summary>Web-based security tools for developers and security professionals</summary>
    
    <description>
        <p>
            Security Utilities is a comprehensive collection of web-based security tools designed for developers, 
            security professionals, and system administrators. The application provides an intuitive dashboard 
            interface for accessing various security-focused utilities.
        </p>
        <p>Features include:</p>
        <ul>
            <li>Password Hash Generator with support for multiple algorithms (bcrypt, Argon2, scrypt)</li>
            <li>Image File Randomizer for forensic data obfuscation</li>
            <li>Secure file upload and processing capabilities</li>
            <li>Dark/Light theme support with user preference persistence</li>
            <li>Content Security Policy compliance for enhanced security</li>
            <li>CSRF protection and rate limiting for secure operations</li>
        </ul>
        <p>
            The application runs as a local web server, providing a modern web interface while maintaining 
            complete data privacy by processing everything locally on your machine.
        </p>
    </description>
    
    <launchable type="desktop-id">dev.secutils.SecurityUtils.desktop</launchable>
    
    <provides>
        <binary>security-utils</binary>
    </provides>
    
