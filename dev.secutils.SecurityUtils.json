{
    "app-id": "dev.secutils.SecurityUtils",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "security-utils",
    "finish-args": [],
    "modules": [
        {
            "name": "php",
            "buildsystem": "autotools",
            "config-opts": [
                "--enable-gd",
                "--with-freetype",
                "--with-jpeg",
                "--enable-fileinfo",
                "--enable-session",
                "--enable-cli"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.php.net/distributions/php-8.4.27.tar.gz",
                    "sha256": "5bafed9994c1a49796b25b5f61c22c9183bfe046b6acc7b363842d03c77f972f"
                }
            ]
        },
        {
            "name": "security-utils",
            "buildsystem": "simple",
            "build-commands": [
                "install -d /app/share/security-utils",
                "cp -r *.php css js password_hash_gen_doc.html README.md THIRD_PARTY_ASSETS.md THIRD_PARTY_ASSETS.sha256 RECOVERY_RELEASE_CHECKLIST.md /app/share/security-utils/",
                "install -Dm755 flatpak-wrapper.sh /app/bin/security-utils",
                "install -Dm644 dev.secutils.SecurityUtils.desktop /app/share/applications/dev.secutils.SecurityUtils.desktop",
                "install -Dm644 dev.secutils.SecurityUtils.svg /app/share/icons/hicolor/scalable/apps/dev.secutils.SecurityUtils.svg",
                "install -Dm644 dev.secutils.SecurityUtils.appdata.xml /app/share/metainfo/dev.secutils.SecurityUtils.appdata.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                },
                {
                    "type": "file",
                    "path": "flatpak-wrapper.sh",
                    "dest-filename": "flatpak-wrapper.sh"
                },
                {
                    "type": "file",
                    "path": "dev.secutils.SecurityUtils.desktop",
                    "dest-filename": "dev.secutils.SecurityUtils.desktop"
                },
                {
                    "type": "file",
                    "path": "dev.secutils.SecurityUtils.svg",
                    "dest-filename": "dev.secutils.SecurityUtils.svg"
                },
                {
                    "type": "file",
                    "path": "dev.secutils.SecurityUtils.appdata.xml",
                    "dest-filename": "dev.secutils.SecurityUtils.appdata.xml"
                }
            ]
        }
    ]
}
